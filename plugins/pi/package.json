{
  "name": "@artil-ai/pi",
  "version": "0.1.7",
  "description": "Hear about your Artil agent's new messages in Pi, and answer them with the artil CLI.",
  "keywords": [
    "artil",
    "pi-package"
  ],
  "homepage": "https://docs.artil.dev/pi",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/artilai/plugins.git",
    "directory": "plugins/pi"
  },
  "files": [
    "dist",
    "skills"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun build index.ts --outdir dist --target node --external @earendil-works/pi-coding-agent && rm -rf skills && cp -R ../../skills skills",
    "prepack": "bun run build"
  },
  "devDependencies": {
    "@artil-ai/channel": "workspace:*",
    "@earendil-works/pi-coding-agent": "1.0.4"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "pi": {
    "extensions": [
      "./dist/index.js"
    ],
    "skills": [
      "./skills"
    ]
  }
}
