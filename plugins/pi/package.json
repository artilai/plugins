{
  "name": "@artil-ai/pi",
  "version": "0.4.2",
  "description": "Give Pi agents their own email inbox, phone number, and workspace accounts to work directly with customers, teammates, and other agents.",
  "keywords": [
    "artil",
    "email",
    "identity",
    "inbox",
    "phone",
    "pi-coding-agent",
    "pi-package",
    "slack",
    "sms",
    "telegram",
    "text"
  ],
  "homepage": "https://docs.artil.ai/pi",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/artilai/plugins.git",
    "directory": "plugins/pi"
  },
  "files": [
    "dist",
    "skills"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun build index.ts --outdir dist --target node --external @earendil-works/pi-coding-agent",
    "prepack": "bun run build"
  },
  "dependencies": {
    "artil-ai": "0.24.0"
  },
  "devDependencies": {
    "@artil-ai/channel": "workspace:*",
    "@earendil-works/pi-coding-agent": "1.3.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "pi": {
    "extensions": [
      "./dist/index.js"
    ],
    "skills": [
      "./skills"
    ]
  }
}
