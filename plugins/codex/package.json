{
  "name": "@artil-ai/codex",
  "version": "0.1.5",
  "description": "Email, SMS and Telegram for Codex. Your agent gets its own Artil inbox and phone number, reads and answers messages, and keeps API keys and 2FA codes.",
  "keywords": [
    "2fa",
    "ai-agents",
    "artil",
    "codex",
    "codex-plugin",
    "email",
    "inbox",
    "phone-number",
    "secrets",
    "sms",
    "telegram"
  ],
  "homepage": "https://artil.ai",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/artilai/plugins.git",
    "directory": "plugins/codex"
  },
  "files": [
    ".codex-plugin",
    "skills"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf skills && cp -R ../../skills skills",
    "prepack": "bun run build"
  }
}
