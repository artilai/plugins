{
  "name": "@artil-ai/openclaw",
  "version": "0.1.10",
  "description": "Email, SMS and Telegram for OpenClaw. Your agent gets its own Artil inbox and phone number, reads and answers messages, and keeps API keys and 2FA codes.",
  "keywords": [
    "2fa",
    "ai-agents",
    "artil",
    "email",
    "inbox",
    "openclaw",
    "openclaw-plugin",
    "phone-number",
    "secrets",
    "sms",
    "telegram"
  ],
  "homepage": "https://docs.artil.ai/openclaw",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/artilai/plugins.git",
    "directory": "plugins/openclaw"
  },
  "files": [
    "dist",
    "skills",
    "openclaw.plugin.json"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun build index.ts --outdir dist --target node --external openclaw && rm -rf skills && cp -R ../../skills skills",
    "prepack": "bun run build"
  },
  "devDependencies": {
    "@artil-ai/channel": "workspace:*",
    "openclaw": "2026.9.8"
  },
  "peerDependencies": {
    "openclaw": ">=2026.9.8"
  },
  "openclaw": {
    "extensions": [
      "./index.ts"
    ],
    "runtimeExtensions": [
      "./dist/index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.9.8"
    },
    "install": {
      "minHostVersion": ">=2026.9.8"
    }
  }
}
