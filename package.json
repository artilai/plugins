{
  "name": "plugins",
  "private": true,
  "workspaces": [
    "packages/*",
    "plugins/*"
  ],
  "type": "module",
  "scripts": {
    "build": "bun run --filter './plugins/*' build",
    "check": "oxlint && oxfmt --check && tsc && bun test",
    "check:claude-code": "plugins/claude-code/check.sh",
    "check:codex": "plugins/codex/check.sh",
    "check:hermes": "plugins/hermes/check.sh",
    "check:skills": "bun scripts/check-skills.ts",
    "format": "oxlint --fix && oxfmt"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "typescript": "7.0.2"
  },
  "packageManager": "bun@1.3.14"
}
